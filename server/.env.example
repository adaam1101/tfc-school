PORT=5000
NODE_ENV=development

# MongoDB Connection String:
# You can use your MongoDB Atlas URI (from your Render Dashboard -> Environment) 
# or local MongoDB: mongodb://127.0.0.1:27017/tfc_school
MONGO_URI=mongodb://127.0.0.1:27017/tfc_school

JWT_SECRET=tfc_school_super_secret_jwt_key_development_2026_secure
JWT_EXPIRES_IN=7d

SCHOOL_SHORT=TFC
SCHOOL_TIMEZONE=Africa/Algiers
CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173,http://127.0.0.1:5173

NOTIFICATIONS_ENABLED=false
WHATSAPP_ENABLED=false
TWO_FACTOR_ENABLED=false
